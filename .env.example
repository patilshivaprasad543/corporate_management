# ==========================================
# CBTMS ENVIRONMENT CONFIGURATION
# ==========================================

# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# MySQL Database (use SPRING_PROFILES_ACTIVE=mysql for Flyway-managed schema)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/corporate_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=corporate_user
SPRING_DATASOURCE_PASSWORD=corporate_pass

# JWT Security
JWT_SECRET=change-me-before-production-use-a-256-bit-secret-key-value
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# OTP
OTP_PROVIDER=mock
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Mail (SMTP)
SPRING_MAIL_HOST=smtp.sendgrid.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=your_sendgrid_key_here

# AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# External Provider Keys (Optional)
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here

# File Storage
FILE_UPLOAD_MAX_SIZE=10MB
